# Configuración de Dispositivo Android y OCR para ClashFarmerbot
# Serial ADB de tu dispositivo (ejecuta 'adb devices' para ver el identificador)
COC_DEVICE_SERIAL=your_device_serial_here

# Ruta ejecutable al binario de Tesseract-OCR (opcional si ya está en tu variable PATH del sistema)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
